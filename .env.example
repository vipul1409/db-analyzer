# Copy to .env (git-ignored) and fill in real values:  cp .env.example .env
# Load with: uv run --env-file .env <cmd>   or   set -a; source .env; set +a

# OpenAI API key for the agent (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-proj-REPLACE_ME
export DBX_HOME="$(mktemp -d)"                # a clean local store for the demo
export DBX_DSN=postgresql://db_analyzer:db_analyzer@localhost:5417/shop

# Optional debug logging. When DBX_LOG_FILE is set, `dbx serve|analyze|chat` write the
# db_analyzer logger tree (including the exact Query Store SQL) to that file. Level defaults
# to INFO; set DBX_LOG_LEVEL=DEBUG for more. Unset means no logging.
# export DBX_LOG_FILE=/tmp/dbx.log
# export DBX_LOG_LEVEL=INFO